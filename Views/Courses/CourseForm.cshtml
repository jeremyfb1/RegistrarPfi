@model Models.Course

@{
    bool creating = ViewBag.Creating != null ? (bool)ViewBag.Creating : false;
    string sessionCourante = Models.NextSession.Caption;
}

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()


    <div class="section roundedBorder">
        <details open>
            <summary>Informations @(!creating ? " - [" + Model.Code + "]" : "")</summary>
            <hr />
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="form-group mb-2">
                @Html.LabelFor(model => model.Session, "Session", new { @class = "control-label fw-bold" })
                @Html.EditorFor(model => model.Session, new { htmlAttributes = new { @class = "form-control", type = "number" } })
            </div>

            <div class="form-group mb-2">
                @Html.LabelFor(model => model.Code, "Sigle", new { @class = "control-label fw-bold" })
                @Html.EditorFor(model => model.Code, new { htmlAttributes = new { @class = "form-control" } })
            </div>

            <div class="form-group mb-2">
                @Html.LabelFor(model => model.Title, "Titre", new { @class = "control-label fw-bold" })
                @Html.EditorFor(model => model.Title, new { htmlAttributes = new { @class = "form-control" } })
            </div>
        </details>
    </div>

    if (!creating)
    {
        <div class="section roundedBorder mt-3">
            <details open>
                <summary>Inscriptions: @sessionCourante</summary>

                @Helper.SelectionLists("selectedStudentsId", (System.Web.Mvc.SelectList)ViewBag.Registrations, (System.Web.Mvc.SelectList)ViewBag.Students)
            </details>
        </div>
    }

    <input id="submit" type="submit" value="Enregistrer" class="btn btn-primary" style="display:none">
}